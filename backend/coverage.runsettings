<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Ambev\.DeveloperEvaluation\.(Application|Common|Domain|IoC|ORM|WebApi)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]Migrations[\\/].*</Source>
        <Source>.*[\\/]Sales[\\/]MonetaryConstraints\.cs$</Source>
        <Source>.*[\\/]Common[\\/]PaginatedResponse\.cs$</Source>
      </Exclude>
    </Sources>
    <EnableStaticManagedInstrumentation>False</EnableStaticManagedInstrumentation>
    <EnableDynamicManagedInstrumentation>True</EnableDynamicManagedInstrumentation>
  </CodeCoverage>
</Configuration>
