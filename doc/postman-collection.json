    {
      "name": "Cleanup",
      "description": "Deletes the temporary user created by this collection. Sale cancellation is performed in the Sales folder.",
      "item": [
        {
          "name": "Delete test user",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Users", "{{userId}}"]
            }
          },
          "response": [],
